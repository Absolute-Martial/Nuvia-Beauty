# Public shop URL
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Backend API endpoint
NEXT_PUBLIC_REST_API_ENDPOINT=http://localhost:8000

# Language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_ENABLE_MULTI_LANG=false
NEXT_PUBLIC_AVAILABLE_LANGUAGES=en

# Payments - keep empty while payment is disabled in MVP
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_TOKEN=
NEXT_PUBLIC_RAZORPAY_KEY=

# Auth/session
NEXTAUTH_URL=http://localhost:3003
SECRET=replace-with-a-random-secret

# Optional public integrations
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=
NEXT_PUBLIC_INSTAGRAM_BASIC_DISPLAY_USER_TOKEN=
NEXT_PUBLIC_MAILCHIMP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# App version
NEXT_PUBLIC_VERSION=6.8.0

