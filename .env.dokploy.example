APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=https://your-backend-domain.example
FRONTEND_URL=https://your-storefront-domain.example
ADMIN_URL=https://your-admin-domain.example
VENDOR_URL=https://your-vendor-domain.example
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nuvia_beauty
DB_USERNAME=nuvia_beauty
DB_PASSWORD=change-me
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
FILESYSTEM_DISK=s3
FILESYSTEM_CLOUD=s3
IMPORT_FILESYSTEM_DISK=s3
MEDIA_DISK=s3
AISTOR_REGION=us-east-1
AISTOR_BUCKET=nuvia-public
AISTOR_ENDPOINT=http://aistor:9000
AISTOR_PUBLIC_URL=https://your-public-bucket-domain.example
AISTOR_USE_PATH_STYLE_ENDPOINT=true
AISTOR_BUCKET_ENDPOINT=false
AISTOR_ROOT_PREFIX=
NUVIA_BACKEND_IMAGE=ghcr.io/absolute-martial/nuvia-beauty-backend:development
NUVIA_ADMIN_IMAGE=ghcr.io/absolute-martial/nuvia-beauty-admin-panel:development
NUVIA_VENDOR_IMAGE=ghcr.io/absolute-martial/nuvia-beauty-vendor-portal:development
NUVIA_STOREFRONT_IMAGE=ghcr.io/absolute-martial/nuvia-beauty-storefront:development
CLOUDFLARE_TUNNEL_TOKEN=change-me
AISTOR_API_PORT=9000
AISTOR_CONSOLE_PORT=9001
AISTOR_LICENSE_FILE=/opt/nuvia/aistor/license/minio.license
AISTOR_ROOT_USER_FILE=/opt/nuvia/aistor/secrets/root_user
AISTOR_ROOT_PASSWORD_FILE=/opt/nuvia/aistor/secrets/root_password
AISTOR_DATA_DIR=/opt/nuvia/aistor/data
AISTOR_CERTS_DIR=/opt/nuvia/aistor/certs
