{
    "name": "marvel/shop",
    "description": ":package_description",
    "version": "dev-main",
    "license": "license",
    "authors": [
        {
            "name": "Nuvia Beauty",
            "email": "support@absolute-martial.com",
            "homepage": "https://github.com/Absolute-Martial/Nuvia-Beauty"
        }
    ],
    "homepage": "https://github.com/Absolute-Martial/Nuvia-Beauty",
    "keywords": [
        "Laravel",
        "Shop"
    ],
    "require": {
        "illuminate/support": "^12.0|^13.0",
        "nuwave/lighthouse": "^6.66.0",
        "cviebrock/eloquent-sluggable": "^13.0",
        "laravel/sanctum": "^4.3.2",
        "prettus/l5-repository": "^3.0.1",
        "spatie/laravel-medialibrary": "^11.22.1",
        "spatie/laravel-permission": "^6.25.0",
        "php-http/guzzle7-adapter": "1.0.0",
        "bensampo/laravel-enum": "^6.14.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "drewm/mailchimp-api": "^2.5",
        "spatie/laravel-newsletter": "5.1.1",
        "spatie/period": "2.4.0",
        "kodeine/laravel-meta": "^2.2.6",
        "maatwebsite/excel": "^3.1.69",
        "mll-lab/graphql-php-scalars": "^6.4.1",
        "mll-lab/laravel-graphiql": "^4.1",
        "pusher/pusher-php-server": "^7.2",
        "openai-php/client": "^0.7.4",
        "twilio/sdk": "7.12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "mockery/mockery": "1.5.1",
        "orchestra/testbench": "^11.0",
        "sempro/phpunit-pretty-print": "1.4.0"
    },
    "autoload": {
        "classmap": [
            "src"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Marvel\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marvel\\ShopServiceProvider"
            ],
            "aliases": {
                "Shop": "Marvel\\Facades\\Shop"
            }
        }
    }
}
