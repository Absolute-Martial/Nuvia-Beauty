{
    "name": "nuvia/beauty-api",
    "type": "project",
    "description": "Nuvia Beauty API, a complete commerce engine",
    "keywords": [
        "marvel",
        "graphql",
        "rest-api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "doctrine/dbal": "3.7.1",
        "guzzlehttp/guzzle": "^7.8.2",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "marvel/shop": "dev-main",
        "messagebird/php-rest-api": "^4.0.1",
        "psr/log": "3.0.0",
        "stevebauman/purify": "^6.3.2",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "1.21.0",
        "laravel/sail": "^1.58",
        "mockery/mockery": "1.5.1",
        "nunomaduro/collision": "^8.9.4",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12",
        "squizlabs/php_codesniffer": "3.7.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "andersao/l5-repository": {
            "type": "path",
            "url": "packages/compat/andersao/l5-repository"
        },
        "prettus/laravel-validation": {
            "type": "path",
            "url": "packages/compat/prettus/laravel-validation"
        },
        "kodeine/laravel-meta": {
            "type": "path",
            "url": "packages/compat/kodeine/laravel-meta"
        },
        "marvel/shop": {
            "type": "path",
            "url": "packages/marvel"
        }
    }
}
